{
  "name": "eiff-control",
  "private": true,
  "version": "0.1.0",
  "description": "EIFF Control - sistema integrado de gestao financeira, obras, tesouraria e decisao",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && eslint src && vite build",
    "preview": "vite preview --port 5173",
    "test": "vitest run",
    "migrate:planilha": "node scripts/migrate-spreadsheet.mjs",
    "deploy:sql": "node scripts/build-deploy-sql.mjs",
    "db:query": "supabase db query --linked --project-ref dduobppgomqyagjviwpx",
    "lint": "eslint src"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.114.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "netlify-cli": "^27.4.2",
    "supabase": "^2.116.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
