# Fase 1 (Supabase). Enquanto vazio, o app usa o repositório local (localStorage + seed.json).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Integrações executadas no servidor (n8n) — nunca expor no cliente web
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
MAIS_CONTROLE_API_TOKEN=

# Vibe Prospecting (Explorium Data API) — usada SO por scripts/vibe.mjs e pela funcao serverless; nunca no front-end.
# Coloque a chave real em .env.local (ignorado pelo git) ou nas variaveis do Netlify.
VIBE_API_KEY=
# Service role do Supabase: SO no painel do Netlify (server-side), para as RPCs de reserva/consumo do Vibe.
# Nunca com prefixo VITE_, nunca no navegador, nunca em logs, nunca em arquivo versionado.
SUPABASE_SERVICE_ROLE_KEY=

# Geracao de abordagens do Radar por IA (so no painel do Netlify): ANTHROPIC_API_KEY obrigatoria; modelo opcional (padrao: ANTHROPIC_MODEL, senao claude-opus-5)
ANTHROPIC_COMMUNICATION_MODEL=

# Comunicação (Radar): modelo do motor comercial (padrão claude-sonnet-5; NÃO herda ANTHROPIC_MODEL), juiz semântico,
# timeout por chamada (5000-30000 ms, padrão 22000) e deadline total da função (15000-55000 ms, padrão 50000). Só no painel do Netlify.
ANTHROPIC_COMMUNICATION_JUDGE_MODEL=
ANTHROPIC_CALL_TIMEOUT_MS=
COMMUNICATION_DEADLINE_MS=
